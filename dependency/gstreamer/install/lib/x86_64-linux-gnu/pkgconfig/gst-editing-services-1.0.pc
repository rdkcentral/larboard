prefix=/home/jerald/Xumo_Flex2/Larb-cov/Cov-build/dependency/gstreamer/install
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

Name: gst-editing-services-1.0
Description: GStreamer Editing Services
Version: 1.24.13.1
Requires: gstreamer-1.0, gstreamer-base-1.0, gstreamer-pbutils-1.0, gstreamer-controller-1.0
Requires.private: gstreamer-video-1.0, orc-0.4, gstreamer-audio-1.0, gstreamer-tag-1.0, glib-2.0 >=  2.64.0, gobject-2.0, gmodule-no-export-2.0, zlib, gio-2.0
Libs: -L${libdir} -lges-1.0
Libs.private: -lm -pthread
Cflags: -I${includedir}/gstreamer-1.0
