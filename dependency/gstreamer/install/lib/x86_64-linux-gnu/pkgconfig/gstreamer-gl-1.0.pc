prefix=/home/jerald/Xumo_Flex2/Larb-cov/Cov-build/dependency/gstreamer/install
datadir=${prefix}/share
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu
libexecdir=${prefix}/libexec

exec_prefix=${prefix}
toolsdir=${exec_prefix}/bin
pluginsdir=${libdir}/gstreamer-1.0
girdir=${datadir}/gir-1.0
typelibdir=${libdir}/girepository-1.0
pluginscannerdir=${libexecdir}/gstreamer-1.0
gl_platforms=egl
gl_winsys=egl surfaceless gbm
gl_apis=gles2 gl

Name: gstreamer-gl-1.0
Description: Streaming media framework, OpenGL plugins libraries
Version: 1.24.13.1
Requires: gstreamer-base-1.0, gstreamer-1.0, gstreamer-video-1.0
Requires.private: orc-0.4, gudev-1.0, gstreamer-allocators-1.0, glib-2.0 >=  2.64.0, gobject-2.0, gmodule-no-export-2.0, glesv2, opengl, egl, libudev >=  251, libdrm >=  2.4.98, gbm
Libs: -L${libdir} -lgstgl-1.0
Libs.private: -lm -pthread
Cflags: -I${includedir}/gstreamer-1.0 -I${libdir}/gstreamer-1.0/include
