prefix=/home/jerald/Xumo_Flex2/Larb-cov/Cov-build/dependency/gstreamer/install
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

Name: vorbisfile
Description: vorbisfile is a library that provides a convenient high-level API for decoding and basic manipulation of all Vorbis I audio streams
Version: 1.3.7
Requires.private: vorbis, ogg
Libs: -L${libdir} -lvorbisfile
Libs.private: -lm
Cflags: -I${includedir}
